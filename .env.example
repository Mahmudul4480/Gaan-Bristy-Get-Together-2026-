# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase — required for cross-device Honorable Guest sync (Admin + public gallery).
# Get these values from Firebase Console > Project Settings > General > Your apps > SDK setup.
# NEVER put real values in this .env.example file — only in your local .env (already gitignored).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Analytics 4 — optional override. If empty, VITE_FIREBASE_MEASUREMENT_ID is used.
VITE_GA_MEASUREMENT_ID=""

# Google Search Console HTML-tag verification token (content= value only).
VITE_GSC_VERIFICATION=""

# Optional: FormSubmit webhook used for admin payment email notifications.
VITE_PAYMENT_NOTIFY_WEBHOOK=""

# Alpha SMS (sms.net.bd) — used by api/send-sms.ts to send the registration
# confirmation SMS. Server-side only (no VITE_ prefix) — never exposed to the
# browser. Get your key from portal.sms.net.bd > API page.
SMS_API_KEY="YOUR_ALPHA_SMS_API_KEY"
# Optional — only if you have an approved Sender ID/Masking name.
SMS_SENDER_ID=""
