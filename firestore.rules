rules_version = '2';

// Firestore Security Rules for Gaan Bristy Get Together 2026
// ------------------------------------------------------------
// Paste this into: Firebase Console > Build > Firestore Database > Rules tab > Publish.
//
// Collection `honorableGuests/{ticketId}` stores every registered guest's
// Honorable Guest Card (name, photo, QR target, etc). It must stay publicly
// READABLE (that's the whole point — scanning a guest's QR code, from any
// device, anywhere, with no login, must show their card). Writes are
// loosely validated below since this app has no user authentication system;
// this is NOT bulletproof against a determined attacker hitting the API
// directly, but it blocks casual abuse and malformed data.
// Public registration can only create status=Pending. Instant Confirmed
// cards require createdByAdmin == true (Admin Manual Card).
//
// For stronger protection later, consider:
//   1. Firebase App Check (blocks non-browser / bot traffic to Firestore).
//   2. Firebase Auth for the Admin Panel, then restrict `update`/`delete`
//      to `request.auth != null` admin accounts only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /honorableGuests/{ticketId} {
      allow read: if true;

      allow create: if request.resource.data.ticketId == ticketId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.familyName is string
        && request.resource.data.phone is string
        && request.resource.data.transactionId is string
        && request.resource.data.status is string
        && request.resource.data.issueDate is string
        && (
          request.resource.data.status == 'Pending'
          || (request.resource.data.status == 'Confirmed'
              && request.resource.data.createdByAdmin == true)
        );

      allow update: if request.resource.data.ticketId == ticketId;

      allow delete: if true;
    }

    match /cardDeleteRequests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.ticketId is string
        && request.resource.data.guestName is string
        && request.resource.data.requestedBy is string
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt is string;
      allow update: if true;
      allow delete: if true;
    }

    // Memories Gallery — photos uploaded from the Admin Panel (see
    // src/components/AdminGalleryManager.tsx). Must stay publicly readable
    // since it powers the public gallery section on the homepage.
    match /galleryPhotos/{photoId} {
      allow read: if true;

      allow create: if request.resource.data.title is string
        && request.resource.data.url is string
        && request.resource.data.category in ['Previous Events', 'Family Meeting', 'Performance', 'Family Funny Moment']
        && request.resource.data.createdAt is string
        && (!('featured' in request.resource.data) || request.resource.data.featured is bool);

      allow update: if request.resource.data.title == resource.data.title
        && request.resource.data.url == resource.data.url
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.featured is bool;

      allow delete: if true;
    }

    // Program budget — manual income/expense entries. Admin Panel UI shows this
    // tab only to Super Admin; Card Editors must not see the ledger.
    match /programLedger/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.kind in ['income', 'expense']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if true;
    }

    // Digital Guestbook — public read/write so every visitor sees the same
    // messages live. create validates required fields; update is limited to
    // the likes counter only.
    match /guestbookEntries/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.likes is number
        && request.resource.data.likes == 0
        && request.resource.data.createdAt is string;

      allow update: if request.resource.data.name == resource.data.name
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likes is number
        && request.resource.data.likes >= 0;

      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
